# postgres (superuser created by the image on first init) 
POSTGRES_USER=db_owner
POSTGRES_PASSWORD=
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# Must stay inside the postgres_data volume
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# pgbouncer for 01_pgbouncer_auth.sql user
PGBOUNCER_AUTH_PASSWORD=
PGBOUNCER_PORT=6432

# pgadmin setup SMTP later
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# grafana login + read-only DB role from 06_monitoring.sql
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_MONITOR_PASSWORD=
GRAFANA_PORT=3000

# admin role for a second team member (02_admin_role.sql)
DB_ADMIN_PASSWORD=

# backups (optional healthchecks.io ping URL) still not sure about it
HEALTHCHECK_URL=

# one service password per bot
WALLET_TRACKER_SERVICE_PASSWORD=