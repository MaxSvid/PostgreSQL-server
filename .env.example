# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# PGDATA is required and must stay inside the postgres_data volume
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

#pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=

# PgBouncer
PGBOUNCER_PORT=
PGBOUNCER_AUTH_PASSWORD=

# Grafana
GRAFANA_PORT= 
GRAFANA_ADMIN_PASSWORD= 
GRAFANA_MONITOR_PASSWORD=

# Wallet tracking
WALLET_TRACKER_SERVICE_PASSWORD=
